{
  "experiment": "EXP-023-workload-drift",
  "version": "EXP023-R1",
  "label": "retrospective synthesis / reproducibility freeze (NOT frozen before data)",
  "statements": [
    "the original EXP-023 hypothesis (2026-10-03) predates the transition campaign",
    "the exact closure operationalisation is frozen now (2026-10-12)",
    "all four source traces and their temporal analyses already exist",
    "FH-028 and FH-029 outcomes are already known",
    "the JSD operationalisation was specified after the data existed",
    "no untouched-holdout or confirmatory claim is made"
  ],
  "jsd": {
    "window_counted_decode_steps": 64,
    "base": 2,
    "phase": "decode, counted steps only",
    "unit": "routed selections per layer (each token's top-k once each)",
    "definition": "M=(P+Q)/2; JSD = 1/2 sum_{P>0} P log2(P/M) + 1/2 sum_{Q>0} Q log2(Q/M); zero terms 0; no smoothing",
    "boundary": "last W counted steps of the old segment vs first W of the new segment",
    "within_reference": "non-overlapping complete W-step windows from each segment start; JSD of adjacent pairs; reference of a boundary = pairs of its old and new segment; pooled over all four segments reported too",
    "outputs": "effect sizes and descriptive summaries only"
  },
  "transient": {
    "policies": [
      "ablate-frozen",
      "adaptive-e64"
    ],
    "budgets": [
      "4G",
      "2G",
      "1.5G"
    ],
    "boundaries": [
      1,
      2,
      3
    ],
    "source": "adaptation_v2.csv (signed values kept)",
    "summary_keys": [
      "gain_vs_frozen_misses",
      "A_fixed_mean_allocation_gain",
      "A_share_of_gain_mean_alloc",
      "oracle_potential_B_segment_switching",
      "reaction_lag_cost_vs_instant_piecewise"
    ]
  },
  "verdict_logic": "FALSIFIED for the current controller iff the fixed sources reproduce FH-029 (A_share_of_gain_mean_alloc > 1 and reaction_lag_cost_vs_instant_piecewise < 0 in all 4 traces x 3 budgets); otherwise no verdict. JSD never sets the verdict.",
  "output_schema": {
    "source_manifest.json": "sources with file paths and SHA-256",
